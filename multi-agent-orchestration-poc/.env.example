# Copy this file to .env and fill in your values
# cp .env.example .env

# The shared credentials file uses COMET_API_KEY — each script aliases it to
# OPIK_API_KEY at startup, since that's the only name the SDK reads.
COMET_API_KEY=
OPIK_WORKSPACE=

# Optional — overrides the project every script logs to (defaults to
# "multi-agent-orchestration-poc" if unset). Set this locally to point a run
# at a different workspace/project without editing any tracked file.
OPIK_PROJECT_NAME=

# Optional — only needed for a single-tenant/self-hosted Opik instance
# (e.g. a customer's own comet-hosted.com deployment). Leave unset for the
# standard comet.com cloud. Also used to derive the OTel OTLP ingest endpoint
# (see otel_setup.py).
OPIK_URL_OVERRIDE=

# Required — every agent (triage, specialists, synthesis) is a real
# agent_framework.openai.OpenAIChatClient. OpenAI only, no other providers.
OPENAI_API_KEY=
