# Copy this file to .env and fill in your values
# cp .env.example .env

# The shared credentials file uses COMET_API_KEY — each script aliases it to
# OPIK_API_KEY at startup, since that's the only name the SDK reads.
COMET_API_KEY=
OPIK_WORKSPACE=

# Optional — overrides the project every script logs to (defaults to
# "genai-gateway-persona-poc" if unset). Set this locally to point a run at a
# different workspace/project without editing any tracked file.
OPIK_PROJECT_NAME=

# Optional — only needed for a single-tenant/self-hosted Opik instance
# (e.g. a customer's own comet-hosted.com deployment). Leave unset for the
# standard comet.com cloud.
OPIK_URL_OVERRIDE=

# At least one is required — used directly via llm_clients.py's provider
# dispatch (no LiteLLM).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
