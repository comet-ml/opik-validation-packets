# Copy this file to .env and fill in your values
# cp .env.example .env

# Comet MPM (Steps 01-03, 05) and Comet Model Registry (Step 04) share the
# same account credentials.
COMET_API_KEY=
COMET_WORKSPACE=

# Optional -- overrides the MPM model name (defaults to
# "demand-forecast-poc" if unset). Also used as the Model Registry
# name in Step 04, so the two stay linked -- see config.py.
MPM_MODEL_NAME=

# Optional -- overrides the Experiment Management project Step 04 registers
# model versions under (defaults to "mpm-monitoring-poc" if unset).
# This is a plain Experiment Management project, separate from the MPM
# model's own page.
COMET_PROJECT_NAME=
